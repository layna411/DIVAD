# ===================================================================
# DIVAD Pediatric Occupational Therapy System - Environment Configuration
# Template file: Copy to .env and adjust credentials as required.
# ===================================================================

# Frontend Configuration (Vite)
VITE_APP_TITLE="DIVAD - Dressing Independence Visual & Auditory Device"
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/api/hardware/ws

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MySQL Database Configuration
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=divad_db

# Security & JWT Authentication
JWT_SECRET=your_secure_random_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Physical Hardware BLE Configuration
VITE_BLE_DEVICE_PREFIX=DIVAD
VITE_BLE_SERVICE_UUID=4fafc201-1fb5-459e-8fcc-c5c9c331914b
VITE_BLE_SENSOR_CHAR_UUID=beb5483e-36e1-4688-b7f5-ea07361b26a8
